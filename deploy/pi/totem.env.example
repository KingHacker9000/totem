# Totem Raspberry Pi production environment
TOTEM_ENV=production
TOTEM_HOST=127.0.0.1
TOTEM_PORT=3000
TOTEM_LOG_LEVEL=info

# Durable state. Point this at a mounted external drive when desired.
TOTEM_DATA_DIR=/var/lib/totem

# Optional package roots. Keep the same manifest/runtime contracts as PC.
TOTEM_EXTENSION_ROOTS=/var/lib/totem/extensions
TOTEM_THEME_ROOTS=/var/lib/totem/themes

# Hardware drivers remain replaceable. These defaults are safe/headless until
# representative hardware is selected and explicitly configured.
TOTEM_DISPLAY_DRIVER=headless
TOTEM_TOUCH_DRIVER=none
TOTEM_AUDIO_DRIVER=none
TOTEM_LED_DRIVER=virtual
