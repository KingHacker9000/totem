{
  "name": "totem",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:apps": "pnpm --parallel --filter \"./apps/*\" dev",
    "validate:live": "node scripts/live-validation.mjs",
    "validate:pi": "node deploy/pi/lifecycle-check.mjs",
    "decommission:pi": "node deploy/pi/decommission.mjs",
    "recovery:verify": "node scripts/state-recovery.mjs verify",
    "recovery:backup": "node scripts/state-recovery.mjs backup",
    "recovery:restore": "node scripts/state-recovery.mjs restore",
    "support:diagnostics": "node scripts/support-diagnostics.mjs",
    "release:config:check": "node scripts/release-config.mjs check",
    "release:config:validate": "node scripts/release-config.mjs validate-env",
    "release:config:smoke": "node scripts/startup-smoke.mjs",
    "release:state:compatibility:check": "node deploy/pi/state-compatibility.mjs validate --release .",
    "release:metadata:check": "node scripts/release-repository-metadata.mjs",
    "release:metadata:check:remote": "node scripts/release-repository-metadata.mjs --remote",
    "release:repos:check": "node scripts/repo-family-validation.mjs",
    "release:repos:check:remote": "node scripts/repo-family-validation.mjs --remote",
    "release:repos:validate": "node scripts/repo-family-validation.mjs --execute",
    "release:docs:check": "node scripts/release-docs.mjs --repo .",
    "release:workflow-actions:check": "node scripts/workflow-actions.mjs --repo .",
    "release:bundle:build": "node scripts/release-bundle.mjs build",
    "release:bundle:verify": "node scripts/release-bundle.mjs verify",
    "release:artifact:scan": "node scripts/release-artifact-scan.mjs",
    "release:third-party:generate": "node scripts/third-party-manifest.mjs generate",
    "release:third-party:verify": "node scripts/third-party-manifest.mjs verify",
    "release:provenance:generate": "node scripts/release-provenance.mjs generate",
    "release:provenance:verify": "node scripts/release-provenance.mjs verify",
    "release:dependencies:audit": "node scripts/release-dependency-audit.mjs",
    "build": "pnpm -r build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run && node --test deploy/pi/readiness.test.mjs deploy/pi/decommission.test.mjs deploy/pi/state-compatibility.node-test.mjs scripts/third-party-manifest.node-test.mjs scripts/release-provenance.node-test.mjs scripts/release-bundle.node-test.mjs scripts/release-artifact-scan.node-test.mjs scripts/release-dependency-audit.node-test.mjs scripts/release-config.node-test.mjs scripts/release-docs.node-test.mjs scripts/workflow-actions.node-test.mjs scripts/state-recovery.node-test.mjs scripts/support-diagnostics.node-test.mjs",
    "check": "pnpm release:config:check && pnpm release:state:compatibility:check && pnpm release:metadata:check && pnpm release:repos:check && pnpm release:docs:check && pnpm release:workflow-actions:check && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "22.20.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
