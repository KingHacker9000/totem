{
  "schema": "totem.release-config/v1",
  "credential_free": true,
  "variables": [
    {"name":"TOTEM_HOST","scope":"runtime","class":"optional","default":"127.0.0.1","secret":false,"validation":"hostname"},
    {"name":"TOTEM_PORT","scope":"runtime","class":"optional","default":"3000","secret":false,"validation":"port"},
    {"name":"TOTEM_LOG_LEVEL","scope":"runtime","class":"optional","default":"info","secret":false,"validation":"log-level"},
    {"name":"TOTEM_ENV","scope":"runtime","class":"optional","default":"development","secret":false,"validation":"environment"},
    {"name":"TOTEM_DATA_DIR","scope":"runtime","class":"local-state","default":"platform-user-data","secret":false,"validation":"path"},
    {"name":"TOTEM_EXTENSION_ROOTS","scope":"runtime","class":"local-state","default":"<TOTEM_DATA_DIR>/extensions","secret":false,"validation":"path-list"},
    {"name":"TOTEM_THEME_ROOTS","scope":"runtime","class":"local-state","default":"<TOTEM_DATA_DIR>/themes","secret":false,"validation":"path-list"},
    {"name":"TOTEM_ACTIVE_THEME","scope":"runtime","class":"optional","default":null,"secret":false,"validation":"package-id"},
    {"name":"TOTEM_EXTENSION_GRANTS","scope":"runtime","class":"security-policy","default":null,"secret":false,"validation":"json-object"},
    {"name":"TOTEM_STT_PROVIDER","scope":"runtime","class":"optional","default":"none","secret":false,"validation":"stt-provider"},
    {"name":"TOTEM_STT_EXECUTABLE","scope":"runtime","class":"local-state","default":null,"secret":false,"validation":"path"},
    {"name":"TOTEM_STT_MODEL","scope":"runtime","class":"local-state","default":null,"secret":false,"validation":"path"},
    {"name":"TOTEM_TTS_PROVIDER","scope":"runtime","class":"optional","default":"none","secret":false,"validation":"tts-provider"},
    {"name":"TOTEM_TTS_EXECUTABLE","scope":"runtime","class":"local-state","default":null,"secret":false,"validation":"path"},
    {"name":"TOTEM_TTS_MODEL","scope":"runtime","class":"local-state","default":null,"secret":false,"validation":"path"},
    {"name":"TOTEM_SPEECH_AGENT_PROVIDER","scope":"runtime","class":"optional","default":"mock","secret":false,"validation":"provider-id"},
    {"name":"TOTEM_SPEECH_VAD_THRESHOLD","scope":"runtime","class":"optional","default":"0.015","secret":false,"validation":"unit-number"},
    {"name":"TOTEM_REGISTRY_TRUSTED_KEYS","scope":"runtime","class":"security-policy","default":null,"secret":false,"validation":"registry-trusted-keys"},
    {"name":"TOTEM_REMOTE_ACCESS_LAYER","scope":"runtime","class":"security-metadata","default":null,"secret":false,"validation":"nonempty-string"},
    {"name":"TOTEM_DISPLAY_DRIVER","scope":"runtime","class":"optional","default":"headless","secret":false,"validation":"nonempty-string"},
    {"name":"TOTEM_TOUCH_DRIVER","scope":"runtime","class":"optional","default":"none","secret":false,"validation":"nonempty-string"},
    {"name":"TOTEM_AUDIO_DRIVER","scope":"runtime","class":"optional","default":"none","secret":false,"validation":"nonempty-string"},
    {"name":"TOTEM_LED_DRIVER","scope":"runtime","class":"optional","default":"virtual","secret":false,"validation":"nonempty-string"},

    {"name":"TOTEM_PREFIX","scope":"deployment","class":"local-state","default":"/opt/totem","secret":false,"validation":"path"},
    {"name":"TOTEM_STATE_DIR","scope":"deployment","class":"local-state","default":"/var/lib/totem","secret":false,"validation":"path"},
    {"name":"TOTEM_CONFIG_DIR","scope":"deployment","class":"local-state","default":"/etc/totem","secret":false,"validation":"path"},
    {"name":"TOTEM_SERVICE_USER","scope":"deployment","class":"optional","default":"totem","secret":false,"validation":"nonempty-string"},
    {"name":"TOTEM_SOURCE_DIR","scope":"deployment","class":"local-state","default":"repository-root","secret":false,"validation":"path"},
    {"name":"TOTEM_RELEASE_RETENTION","scope":"deployment","class":"optional","default":"2","secret":false,"validation":"positive-integer"},
    {"name":"TOTEM_MIN_FREE_MIB","scope":"deployment","class":"optional","default":"2048","secret":false,"validation":"positive-number"},

    {"name":"TOTEM_BASE_URL","scope":"validation","class":"optional","default":"http://127.0.0.1:<TOTEM_PORT>","secret":false,"validation":"url"},
    {"name":"TOTEM_ENV_FILE","scope":"validation","class":"local-state","default":"/etc/totem/totem.env","secret":false,"validation":"path"},
    {"name":"TOTEM_READY_TIMEOUT_MS","scope":"validation","class":"optional","default":"15000","secret":false,"validation":"positive-number"},
    {"name":"TOTEM_READY_INITIAL_DELAY_MS","scope":"validation","class":"optional","default":"150","secret":false,"validation":"positive-number"},
    {"name":"TOTEM_READY_MAX_DELAY_MS","scope":"validation","class":"optional","default":"1500","secret":false,"validation":"positive-number"},
    {"name":"TOTEM_READY_REQUEST_TIMEOUT_MS","scope":"validation","class":"optional","default":"2000","secret":false,"validation":"positive-number"},
    {"name":"TOTEM_MIN_FREE_BYTES","scope":"validation","class":"optional","default":"536870912","secret":false,"validation":"positive-number"},
    {"name":"TOTEM_LIVE_WORKSPACE","scope":"validation","class":"local-state","default":null,"secret":false,"validation":"path"}
  ],
  "ambient_platform_inputs": ["NODE_ENV", "LOCALAPPDATA", "XDG_DATA_HOME"],
  "credential_policy": "Provider/service credentials are opt-in external environment variables selected by provider or --service TOKEN_ENV configuration. They are never required for core startup, never enumerated with values, and never embedded in this public contract."
}
